\pard\ql\f0\fs24\sl276\slmult1\sa100 C\u225?c l\u432?\u7907?t smoke \u273?\u227? ch\u7841?y 1 epoch v\u7899?i 1.000 m\u7851?u train, 300 m\u7851?u validation v\u224? 300 m\u7851?u test \u273?\u7875? ki\u7875?m tra ch\u432?\u417?ng tr\u236?nh c\u243? th\u7875? hu\u7845?n luy\u7879?n, l\u432?u v\u224? \u273?\u7885?c l\u7841?i checkpoint, xu\u7845?t ch\u7881? s\u7889? v\u224? d\u7921? \u273?o\u225?n t\u7915? SMILES. {\b \u272?\u226?y l\u224? ki\u7875?m tra ch\u7913?c n\u259?ng, kh\u244?ng ph\u7843?i k\u7871?t qu\u7843? th\u7921?c nghi\u7879?m cu\u7889?i c\u249?ng.}\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 C\u244?ng vi\u7879?c ti\u7871?p theo l\u224? x\u225?c minh m\u244? t\u7843? b\u7897? d\u7919? li\u7879?u, hu\u7845?n luy\u7879?n \u273?\u7847?y \u273?\u7911? hai m\u244? h\u236?nh, so s\u225?nh b\u7857?ng validation, sau \u273?\u243? b\u225?o c\u225?o k\u7871?t qu\u7843? test c\u7911?a m\u244? h\u236?nh \u273?\u432?\u7907?c ch\u7885?n. Hu\u7845?n luy\u7879?n \u273?\u7847?y \u273?\u7911? d\u7921? ki\u7871?n th\u7921?c hi\u7879?n tr\u234?n m\u244?i tr\u432?\u7901?ng c\u243? GPU n\u7871?u s\u7861?n c\u243?; c\u243? th\u7875? gi\u7843?m batch size khi b\u7897? nh\u7899? h\u7841?n ch\u7871?. Sau khi c\u243? checkpoint, vi\u7879?c d\u7921? \u273?o\u225?n ch\u7881? c\u7847?n \u273?\u7885?c model \u273?\u227? l\u432?u.\par
\pard\ql\keepn\sb200\sa90\b\fs28 7 S\u7843?n ph\u7849?m d\u7921? ki\u7871?n v\u224? ph\u7841?m vi ho\u224?n th\u224?nh\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 S\u7843?n ph\u7849?m ch\u237?nh g\u7891?m m\u227? ngu\u7891?n x\u7917? l\u253? d\u7919? li\u7879?u, m\u244? h\u236?nh \u273?\u227? hu\u7845?n luy\u7879?n, bi\u7875?u \u273?\u7891? loss v\u224? accuracy, b\u7843?ng ch\u7881? s\u7889? \u273?\u225?nh gi\u225?, ma tr\u7853?n nh\u7847?m l\u7851?n, b\u7843?ng so s\u225?nh CNN\u8211?BiLSTM v\u7899?i MLP v\u224? m\u7897?t s\u7889? v\u237? d\u7909? d\u7921? \u273?o\u225?n. Ch\u432?\u417?ng tr\u236?nh minh h\u7885?a nh\u7853?n hai SMILES r\u7891?i tr\u7843? c\u225?c m\u227? l\u7899?p c\u243? x\u225?c su\u7845?t Softmax cao nh\u7845?t.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Giao di\u7879?n web l\u224? ph\u7847?n m\u7903? r\u7897?ng n\u7871?u th\u7901?i gian cho ph\u233?p; tr\u7885?ng t\u226?m m\u244?n h\u7885?c l\u224? m\u244? h\u236?nh v\u224? ch\u7845?t l\u432?\u7907?ng th\u7921?c nghi\u7879?m. Ch\u432?a \u273?\u7863?t tr\u432?\u7899?c m\u7897?t ng\u432?\u7905?ng Accuracy hay kh\u7859?ng \u273?\u7883?nh v\u432?\u7907?t tr\u7897?i khi ch\u432?a c\u243? k\u7871?t qu\u7843?. C\u225?c h\u7841?n ch\u7871? c\u7847?n tr\u236?nh b\u224?y g\u7891?m m\u7845?t c\u226?n b\u7857?ng l\u7899?p, m\u7851?u hi\u7871?m, c\u225?ch ly c\u225?c c\u7863?p nhi\u7873?u nh\u227?n, gi\u7899?i h\u7841?n c\u7911?a fingerprint v\u224? vi\u7879?c split hi\u7879?n t\u7841?i ch\u432?a \u273?\u225?nh gi\u225? thu\u7889?c ho\u224?n to\u224?n m\u7899?i.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 N\u7871?u ti\u7871?p t\u7909?c ph\u225?t tri\u7875?n sau ph\u7841?m vi m\u244?n h\u7885?c, c\u243? th\u7875? xem x\u233?t h\u7885?c tr\u7921?c ti\u7871?p tr\u234?n chu\u7895?i SMILES ho\u7863?c d\u249?ng m\u7841?ng n\u417?-ron \u273?\u7891? th\u7883? \u273?\u7875? khai th\u225?c bi\u7875?u di\u7877?n ph\u226?n t\u7917? kh\u225?c. \u272?\u226?y l\u224? h\u432?\u7899?ng m\u7903? r\u7897?ng, ch\u432?a ph\u7843?i th\u224?nh ph\u7847?n \u273?\u227? tri\u7875?n khai.\par
\pard\ql\keepn\sb200\sa90\b\fs28 8 N\u7897?i dung tr\u236?nh b\u224?y mi\u7879?ng kho\u7843?ng hai ph\u250?t\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 \u8220?Em xin \u273?\u7873? xu\u7845?t \u273?\u7873? t\u224?i ph\u226?n lo\u7841?i t\u432?\u417?ng t\u225?c gi\u7919?a hai thu\u7889?c t\u7915? c\u7845?u tr\u250?c ph\u226?n t\u7917? b\u7857?ng m\u244? h\u236?nh CNN k\u7871?t h\u7907?p BiLSTM. B\u224?i to\u225?n nh\u7853?n \u273?\u7847?u v\u224?o l\u224? hai chu\u7895?i SMILES v\u224? d\u7921? \u273?o\u225?n m\u7897?t trong 86 l\u7899?p t\u432?\u417?ng t\u225?c \u273?\u227? c\u243? nh\u227?n trong b\u7897? d\u7919? li\u7879?u.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Em chuy\u7875?n m\u7895?i thu\u7889?c th\u224?nh fingerprint RDKit 2.048 bit, gh\u233?p th\u224?nh vector 4.096 chi\u7873?u, sau \u273?\u243? \u273?\u432?a qua CNN, BiLSTM v\u224? l\u7899?p Softmax. Em \u273?\u7891?ng th\u7901?i x\u226?y d\u7921?ng MLP \u273?\u7875? so s\u225?nh v\u236? fingerprint l\u224? vector bit, n\u234?n ch\u432?a th\u7875? gi\u7843? \u273?\u7883?nh CNN\u8211?BiLSTM s\u7869? t\u7889?t h\u417?n.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Sau khi chu\u7849?n h\u243?a v\u224? c\u225?ch ly c\u225?c tr\u432?\u7901?ng h\u7907?p m\u226?u thu\u7851?n nh\u227?n, d\u7919? li\u7879?u c\u242?n kho\u7843?ng 191 ngh\u236?n m\u7851?u. Em chia train, validation v\u224? test theo t\u7927? l\u7879? 64, 16 v\u224? 20 ph\u7847?n tr\u259?m, \u273?\u7891?ng th\u7901?i ki\u7875?m tra \u273?\u7875? kh\u244?ng tr\u249?ng c\u7863?p c\u249?ng th\u7913? t\u7921? gi\u7919?a c\u225?c t\u7853?p. Do d\u7919? li\u7879?u m\u7845?t c\u226?n b\u7857?ng, em \u432?u ti\u234?n Macro F1 b\u234?n c\u7841?nh Accuracy v\u224? ph\u226?n t\u237?ch ma tr\u7853?n nh\u7847?m l\u7851?n.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Hi\u7879?n em \u273?\u227? x\u226?y d\u7921?ng pipeline v\u224? ch\u7841?y th\u7917? th\u224?nh c\u244?ng hai m\u244? h\u236?nh, nh\u432?ng ch\u432?a c\u243? k\u7871?t qu\u7843? hu\u7845?n luy\u7879?n \u273?\u7847?y \u273?\u7911? \u273?\u7875? k\u7871?t lu\u7853?n ch\u7845?t l\u432?\u7907?ng. B\u432?\u7899?c ti\u7871?p theo l\u224? train \u273?\u7847?y \u273?\u7911?, l\u7921?a ch\u7885?n m\u244? h\u236?nh b\u7857?ng validation v\u224? t\u7893?ng h\u7907?p k\u7871?t qu\u7843? test. S\u7843?n ph\u7849?m ch\u237?nh l\u224? model \u273?\u227? l\u432?u, b\u225?o c\u225?o th\u7921?c nghi\u7879?m v\u224? ch\u432?\u417?ng tr\u236?nh minh h\u7885?a d\u7921? \u273?o\u225?n; giao di\u7879?n l\u224? ph\u7847?n m\u7903? r\u7897?ng n\u7871?u c\u242?n th\u7901?i gian.\u8221?\par
\pard\ql\keepn\sb200\sa90\b\fs28 9 M\u7897?t s\u7889? c\u226?u h\u7887?i c\u243? th\u7875? g\u7863?p\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 {\b V\u236? sao \u273?\u226?y l\u224? Deep Learning khi fingerprint \u273?\u432?\u7907?c RDKit t\u7841?o s\u7861?n?}\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Fingerprint l\u224? b\u432?\u7899?c bi\u7875?u di\u7877?n d\u7919? li\u7879?u. C\u225?c tr\u7885?ng s\u7889? trong m\u7841?ng nhi\u7873?u t\u7847?ng CNN\u8211?BiLSTM ho\u7863?c MLP v\u7851?n \u273?\u432?\u7907?c h\u7885?c t\u7915? d\u7919? li\u7879?u b\u7857?ng lan truy\u7873?n ng\u432?\u7907?c; v\u236? v\u7853?y ph\u7847?n ph\u226?n lo\u7841?i v\u7851?n theo h\u432?\u7899?ng Deep Learning.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 {\b V\u236? sao c\u7847?n MLP?}\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 \u272?\u7875? c\u243? m\u244? h\u236?nh \u273?\u7889?i chi\u7871?u d\u249?ng c\u249?ng d\u7919? li\u7879?u, t\u7915? \u273?\u243? \u273?\u225?nh gi\u225? l\u7907?i \u237?ch v\u224? chi ph\u237? c\u7911?a CNN\u8211?BiLSTM thay v\u236? ch\u7881? b\u225?o c\u225?o m\u7897?t ki\u7871?n tr\u250?c.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 {\b Model c\u243? x\u225?c \u273?\u7883?nh thu\u7889?c d\u249?ng chung an to\u224?n kh\u244?ng?}\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Kh\u244?ng. Ph\u7841?m vi hi\u7879?n t\u7841?i l\u224? ph\u226?n lo\u7841?i c\u225?c l\u7899?p t\u432?\u417?ng t\u225?c trong b\u7897? d\u7919? li\u7879?u; ch\u432?a c\u243? l\u7899?p \u8220?kh\u244?ng t\u432?\u417?ng t\u225?c\u8221?, ch\u432?a x\u225?c minh \u273?\u7847?y \u273?\u7911? \u253? ngh\u297?a c\u225?c nh\u227?n v\u224? ch\u432?a \u273?\u432?\u7907?c ki\u7875?m \u273?\u7883?nh \u273?\u7875? s\u7917? d\u7909?ng th\u7921?c t\u7871?.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 {\b T\u237?nh m\u7899?i n\u7857?m \u7903? \u273?\u226?u?}\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 \u272?\u226?y l\u224? \u273?\u7873? t\u224?i \u7913?ng d\u7909?ng trong ph\u7841?m vi m\u244?n h\u7885?c, kh\u244?ng tuy\u234?n b\u7889? ki\u7871?n tr\u250?c m\u7899?i. Gi\u225? tr\u7883? th\u7921?c hi\u7879?n n\u7857?m \u7903? pipeline c\u243? th\u7875? t\u225?i l\u7853?p, ki\u7875?m tra d\u7919? li\u7879?u v\u224? so s\u225?nh m\u244? h\u236?nh c\u243? ph\u226?n t\u237?ch gi\u7899?i h\u7841?n.\par
