\pard\ql\f0\fs24\sl276\slmult1\sa100 Ki\u7875?m tra tr\u234?n c\u225?c c\u7863?p SMILES \u273?\u227? chu\u7849?n h\u243?a cho th\u7845?y kh\u244?ng c\u243? c\u7863?p c\u249?ng th\u7913? t\u7921? b\u7883? tr\u249?ng gi\u7919?a ba t\u7853?p. Tuy nhi\u234?n, m\u7897?t thu\u7889?c c\u243? th\u7875? xu\u7845?t hi\u7879?n trong nhi\u7873?u t\u7853?p v\u224? c\u7863?p \u273?\u7843?o chi\u7873?u c\u243? th\u7875? n\u7857?m \u7903? t\u7853?p kh\u225?c nhau. V\u236? v\u7853?y, \u273?\u226?y l\u224? \u273?\u225?nh gi\u225? tr\u234?n c\u225?c c\u7863?p m\u7899?i trong b\u7889?i c\u7843?nh c\u225?c thu\u7889?c c\u243? th\u7875? \u273?\u227? \u273?\u432?\u7907?c quan s\u225?t, ch\u432?a ph\u7843?i \u273?\u225?nh gi\u225? kh\u7843? n\u259?ng x\u7917? l\u253? thu\u7889?c ho\u224?n to\u224?n m\u7899?i.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 D\u7919? li\u7879?u m\u7845?t c\u226?n b\u7857?ng m\u7841?nh: l\u7899?p l\u7899?n nh\u7845?t trong train c\u243? 38.987 m\u7851?u, l\u7899?p nh\u7887? nh\u7845?t c\u243? 4 m\u7851?u. M\u7897?t s\u7889? l\u7899?p ch\u7881? c\u243? m\u7897?t m\u7851?u \u7903? validation ho\u7863?c test. \u272?\u226?y l\u224? l\u253? do c\u7847?n d\u249?ng tr\u7885?ng s\u7889? l\u7899?p v\u224? th\u7853?n tr\u7885?ng khi di\u7877?n gi\u7843?i ch\u7881? s\u7889? c\u7911?a t\u7915?ng l\u7899?p hi\u7871?m.\par
\pard\ql\keepn\sb200\sa90\b\fs28 4 Ph\u432?\u417?ng ph\u225?p Deep Learning \u273?\u7873? xu\u7845?t\b0\par
\pard\ql\keepn\sb150\sa70\b\fs25 4.1 Bi\u7875?u di\u7877?n \u273?\u7847?u v\u224?o\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 M\u7895?i SMILES \u273?\u432?\u7907?c RDKit chuy\u7875?n th\u224?nh fingerprint nh\u7883? ph\u226?n d\u224?i 2.048 bit v\u7899?i c\u7845?u h\u236?nh RDKit fingerprint maxPath=5. Hai fingerprint \u273?\u432?\u7907?c gh\u233?p theo \u273?\u250?ng th\u7913? t\u7921? A r\u7891?i B \u273?\u7875? t\u7841?o vector 4.096 chi\u7873?u. \u272?\u7847?u v\u224?o CNN \u273?\u432?\u7907?c \u273?\u7893?i h\u236?nh d\u7841?ng th\u224?nh (4096, 1). RDKit h\u7895? tr\u7907? \u273?\u7885?c c\u7845?u tr\u250?c t\u7915? SMILES v\u224? t\u7841?o fingerprint; c\u7845?u h\u236?nh c\u7909? th\u7875? trong \u273?\u7873? t\u224?i \u273?\u432?\u7907?c gi\u7919? th\u7889?ng nh\u7845?t gi\u7919?a train v\u224? d\u7921? \u273?o\u225?n [1].\par
\pard\ql\keepn\sb150\sa70\b\fs25 4.2 Ki\u7871?n tr\u250?c m\u244? h\u236?nh ch\u237?nh\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Lu\u7891?ng x\u7917? l\u253? c\u7911?a m\u244? h\u236?nh:\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 SMILES A v\u224? SMILES B\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 \u8595?\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 Chu\u7849?n h\u243?a c\u7845?u tr\u250?c v\u224? t\u7841?o hai fingerprint 2048 bit\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 \u8595?\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 Gh\u233?p vector 4096 chi\u7873?u\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 \u8595?\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 B\u7889?n kh\u7889?i Conv1D\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 \u8595?\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 BiLSTM 128 units m\u7895?i chi\u7873?u\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 \u8595?\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 BiLSTM 96 units m\u7895?i chi\u7873?u\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 \u8595?\par
\pard\keep\f1\fs20\sl240\slmult1\sa0 Dense 256 v\u224? Softmax 86 l\u7899?p\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 B\u7889?n l\u7899?p Conv1D s\u7917? d\u7909?ng l\u7847?n l\u432?\u7907?t 16, 32, 48 v\u224? 64 filters, kernel size b\u7857?ng 3, k\u7871?t h\u7907?p Batch Normalization. Ba kh\u7889?i \u273?\u7847?u c\u243? MaxPooling v\u224? Dropout. L\u7899?p BiLSTM \u273?\u7847?u tr\u7843? v\u7873? chu\u7895?i \u273?\u7863?c tr\u432?ng \u273?\u7875? truy\u7873?n sang l\u7899?p BiLSTM ti\u7871?p theo. Dense 256 s\u7917? d\u7909?ng ReLU v\u224? L2 regularization; l\u7899?p cu\u7889?i d\u249?ng Softmax. TensorFlow cung c\u7845?p l\u7899?p Bidirectional \u273?\u7875? b\u7885?c m\u7841?ng h\u7891?i ti\u7871?p theo hai chi\u7873?u [2].\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 CNN \u273?\u432?\u7907?c d\u249?ng \u273?\u7875? th\u7917? h\u7885?c c\u225?c m\u7851?u c\u7909?c b\u7897? tr\u234?n vector \u273?\u7847?u v\u224?o; BiLSTM \u273?\u432?\u7907?c d\u249?ng \u273?\u7875? th\u7917? t\u7893?ng h\u7907?p \u273?\u7863?c tr\u432?ng theo hai chi\u7873?u c\u7911?a bi\u7875?u di\u7877?n sau CNN. Tuy nhi\u234?n, v\u7883? tr\u237? c\u225?c bit fingerprint l\u224? k\u7871?t qu\u7843? m\u227? h\u243?a v\u224? b\u259?m \u273?\u7863?c tr\u432?ng ph\u226?n t\u7917?, kh\u244?ng t\u432?\u417?ng \u273?\u432?\u417?ng th\u7913? t\u7921? nguy\u234?n t\u7917? hay chu\u7895?i SMILES. Do \u273?\u243?, l\u7907?i \u237?ch c\u7911?a CNN\u8211?BiLSTM l\u224? m\u7897?t gi\u7843? thuy\u7871?t c\u7847?n ki\u7875?m ch\u7913?ng, kh\u244?ng ph\u7843?i k\u7871?t lu\u7853?n s\u7861?n c\u243? v\u7873? c\u7845?u tr\u250?c h\u243?a h\u7885?c.\par
\pard\ql\keepn\sb150\sa70\b\fs25 4.3 M\u244? h\u236?nh \u273?\u7889?i chi\u7871?u\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 MLP nh\u7853?n tr\u7921?c ti\u7871?p vector 4.096 chi\u7873?u, \u273?i qua Dense 512, Dropout, Dense 256, Dropout v\u224? Softmax 86 l\u7899?p. C\u7843? MLP v\u224? CNN\u8211?BiLSTM \u273?\u7873?u l\u224? m\u7841?ng h\u7885?c s\u226?u. MLP \u273?\u243?ng vai tr\u242? m\u244? h\u236?nh \u273?\u7889?i chi\u7871?u \u273?\u7875? ki\u7875?m tra li\u7879?u ki\u7871?n tr\u250?c ph\u7913?c t\u7841?p h\u417?n c\u243? th\u7921?c s\u7921? mang l\u7841?i l\u7907?i \u237?ch tr\u234?n c\u249?ng fingerprint.\par
\pard\ql\keepn\sb200\sa90\b\fs28 5 K\u7871? ho\u7841?ch hu\u7845?n luy\u7879?n v\u224? \u273?\u225?nh gi\u225?\b0\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 C\u7845?u h\u236?nh kh\u7903?i \u273?\u7847?u g\u7891?m Adam v\u7899?i learning rate 0,000173, batch size 32 v\u224? t\u7889?i \u273?a 50 epoch. H\u224?m m\u7845?t m\u225?t l\u224? sparse categorical cross entropy. Tr\u7885?ng s\u7889? l\u7899?p ch\u7881? \u273?\u432?\u7907?c t\u237?nh t\u7915? t\u7853?p train \u273?\u7875? gi\u7843?m \u7843?nh h\u432?\u7903?ng c\u7911?a m\u7845?t c\u226?n b\u7857?ng. Dropout, L2 regularization, EarlyStopping v\u224? gi\u7843?m learning rate theo validation loss \u273?\u432?\u7907?c d\u249?ng \u273?\u7875? h\u7895? tr\u7907? ki\u7875?m so\u225?t qu\u225? kh\u7899?p.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Checkpoint \u273?\u432?\u7907?c ch\u7885?n theo validation loss. Trong m\u7895?i c\u7845?u h\u236?nh hu\u7845?n luy\u7879?n, test ch\u7881? \u273?\u432?\u7907?c \u273?\u7885?c \u273?\u7875? \u273?\u225?nh gi\u225? sau khi \u273?\u227? ch\u7885?n checkpoint. C\u225?c \u273?i\u7873?u ch\u7881?nh ti\u7871?p theo v\u224? l\u7921?a ch\u7885?n gi\u7919?a hai ki\u7871?n tr\u250?c c\u7847?n d\u7921?a tr\u234?n validation, tr\u225?nh d\u249?ng test l\u7863?p l\u7841?i \u273?\u7875? ch\u7885?n m\u244? h\u236?nh. N\u7871?u th\u7901?i gian cho ph\u233?p, th\u7921?c nghi\u7879?m n\u234?n ch\u7841?y th\u234?m c\u225?c seed kh\u225?c \u273?\u7875? quan s\u225?t \u273?\u7897? dao \u273?\u7897?ng c\u7911?a k\u7871?t qu\u7843?.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 C\u225?c ch\u7881? s\u7889? s\u7869? b\u225?o c\u225?o g\u7891?m Accuracy, Precision, Recall, Macro F1, Weighted F1 v\u224? Micro F1, k\u232?m ch\u7881? s\u7889? t\u7915?ng l\u7899?p v\u224? ma tr\u7853?n nh\u7847?m l\u7851?n. {\b Macro F1 l\u224? ch\u7881? s\u7889? \u432?u ti\u234?n} v\u236? cho m\u7895?i l\u7899?p m\u7913?c \u273?\u243?ng g\u243?p ngang nhau; Accuracy c\u243? th\u7875? b\u7883? chi ph\u7889?i b\u7903?i l\u7899?p ph\u7893? bi\u7871?n. Trong b\u224?i to\u225?n \u273?\u417?n nh\u227?n n\u224?y, Micro F1 b\u7857?ng Accuracy n\u234?n kh\u244?ng \u273?\u432?\u7907?c xem l\u224? b\u7857?ng ch\u7913?ng \u273?\u7897?c l\u7853?p v\u7873? ch\u7845?t l\u432?\u7907?ng m\u244? h\u236?nh.\par
\pard\ql\f0\fs24\sl276\slmult1\sa100 Vi\u7879?c so s\u225?nh s\u7869? ghi nh\u7853?n c\u7843? th\u7901?i gian hu\u7845?n luy\u7879?n v\u224? t\u224?i nguy\u234?n s\u7917? d\u7909?ng. N\u7871?u CNN\u8211?BiLSTM kh\u244?ng c\u7843?i thi\u7879?n Macro F1 so v\u7899?i MLP, k\u7871?t qu\u7843? \u273?\u243? v\u7851?n c\u243? \u253? ngh\u297?a: ki\u7871?n tr\u250?c ph\u7913?c t\u7841?p ch\u432?a ch\u7855?c ph\u249? h\u7907?p h\u417?n v\u7899?i bi\u7875?u di\u7877?n \u273?\u7847?u v\u224?o hi\u7879?n t\u7841?i.\par
\pard\ql\keepn\sb200\sa90\b\fs28 6 Ti\u7871?n \u273?\u7897? hi\u7879?n t\u7841?i v\u224? c\u244?ng vi\u7879?c ti\u7871?p theo\b0\par
